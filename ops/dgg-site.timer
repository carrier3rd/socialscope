[Unit]
Description=Publish DGG chat stats site every 15 minutes

[Timer]
# Every 15 minutes (was daily at 00:43 UTC until Nov 3, 2026; changed so the live numbers stay current).
# 4 Pages builds an hour, under GitHub's soft limit of 10.
OnCalendar=*:00/15
Persistent=true

[Install]
WantedBy=timers.target
