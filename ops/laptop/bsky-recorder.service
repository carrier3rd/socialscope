[Unit]
Description=Bluesky Jetstream recorder, read-only (socialscope)
After=network-online.target
[Service]
# Standing recorder for the 3-week window. Enable it as soon as the pilot passes (bluesky/RUNBOOK.md step 8):
# it resumes from the pilot's cursor, so there is no gap as long as it starts within about 36 hours.
# Restart it after any change to bluesky/collect/jetstream.py or bluesky/config/targets.yaml.
ExecStart=/usr/bin/systemd-inhibit --what=sleep:idle --mode=block --who=socialscope --why="bluesky recorder" /home/probs/socialscope_data/bskyenv/bin/python -I /home/probs/socialscope/bluesky/collect/jetstream.py
Restart=always
RestartSec=10
[Install]
WantedBy=default.target
